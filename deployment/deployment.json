        "secondaryColor": "#818cf8"
      },
      "homepageTrigger": {
        "runFunction": "https://anywave-workspace-HASH-uc.a.run.app/homepage"
      },
      "universalActions": [
        {
          "label": "Settings",
          "runFunction": "https://anywave-workspace-HASH-uc.a.run.app/settings"
        },
        {
          "label": "Help",
          "openLink": "https://github.com/anywave/anywave-workspace"
        }
      ]
    },
    "gmail": {
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "https://anywave-workspace-HASH-uc.a.run.app/gmail/contextual"
        }
      ]
    },
    "docs": {
      "onFileScopeGrantedTrigger": {
        "runFunction": "https://anywave-workspace-HASH-uc.a.run.app/docs/contextual"
      }
    },
    "sheets": {
      "onFileScopeGrantedTrigger": {
        "runFunction": "https://anywave-workspace-HASH-uc.a.run.app/sheets/contextual"
      }
    }
  }
